# Copy to .env (gitignored) and edit:  cp .env.example .env

# Backend API. Must be an absolute URL (the Capacitor app is not served from the API's origin).
VITE_API_URL=http://localhost:8000

# --- Only used by the Playwright tests (tests/config.ts) ---
# Mailpit web UI, to read password-reset emails (started by the backend's docker compose)
MAILPIT_HOST=http://localhost:8025
# Same admin account as FIRST_SUPERUSER / FIRST_SUPERUSER_PASSWORD in ../badminton-backend/.env
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis
