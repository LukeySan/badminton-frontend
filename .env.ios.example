# For `bun run ios:build` (copy to .env.ios, gitignored). Loaded on top of .env.
# The backend as the iPhone reaches it: your Mac's address on the Wi-Fi
# (`ipconfig getifaddr en0`), not localhost (on the phone that's the phone).
# The backend must run with --host 0.0.0.0 and allow capacitor://localhost (IOS.md).
VITE_API_URL=http://192.168.1.20:8000
